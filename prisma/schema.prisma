generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model Plan {
  id              String    @id @default(uuid())
  name            String
  description     String?
  maxEmployees    Int       @map("max_employees")
  externalProductId String?   @map("external_product_id")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  prices        PlanPrice[]
  organizations Organization[]
  subscriptions OrganizationSubscription[]

  @@map("plans")
}

model PlanPrice {
  id             String   @id @default(uuid())
  planId         String   @map("plan_id")
  externalPriceId  String?  @unique @map("external_price_id")
  priceInCents   Int      @map("price_in_cents")
  currency       String   @default("brl")
  interval       String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_prices")
}

model ConsentTermVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  contentHash String   @map("content_hash")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  consents EmployeeConsent[]

  @@map("consent_term_versions")
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  planId               String?  @map("plan_id")
  externalCustomerId   String?  @unique @map("external_customer_id")
  billingStatus        String   @default("pending") @map("billing_status")
  maxEmployeesOverride Int?     @map("max_employees_override")
  timezone             String   @default("America/Sao_Paulo")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  plan             Plan?    @relation(fields: [planId], references: [id])

  users            OrganizationUser[]
  departments      Department[]
  employees        Employee[]
  invitations      OrganizationInvitation[]
  subscription     OrganizationSubscription?
  webhookEvents    BillingWebhookEvent[]
  surveyDispatches SurveyDispatch[]
  surveyQuestions  SurveyQuestion[]
  surveyResponses  SurveyResponse[]
  surveyConfigs    SurveyConfiguration[]
  documents        Document[]
  actionPlans      ActionPlan[]
  reports          AnonymousReport[]
  alerts           Alert[]
  auditLogs        AuditLog[]
  messageLogs      MessageLog[]
  pgrReviews       PgrReview[]
  consents         EmployeeConsent[]

  @@map("organizations")
}

model OrganizationUser {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String
  passwordHash    String    @map("password_hash")
  name            String
  role            String
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authTokens        AuthToken[]
  termsAcceptances  PlatformTermsAcceptance[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("organization_users")
}

model OrganizationInvitation {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  email     String
  role      String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("organization_invitations")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user OrganizationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model OrganizationSubscription {
  id                   String    @id @default(uuid())
  tenantId             String    @unique @map("tenant_id")
  planId               String    @map("plan_id")
  externalSubscriptionId String    @unique @map("external_subscription_id")
  status               String
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  snapshotPlanName     String    @map("snapshot_plan_name")
  snapshotMaxEmployees Int       @map("snapshot_max_employees")
  snapshotPriceInCents Int       @map("snapshot_price_in_cents")
  snapshotInterval     String    @map("snapshot_interval")
  snapshotExternalPriceId String   @map("snapshot_external_price_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("organization_subscriptions")
}

model BillingWebhookEvent {
  id            String    @id @default(uuid())
  tenantId      String?   @map("tenant_id")
  externalEventId String    @unique @map("external_event_id")
  type          String
  payload       Json?
  processedAt   DateTime? @map("processed_at")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("billing_webhook_events")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees            Employee[]
  surveyConfigurations SurveyConfiguration[]
  alerts               Alert[]

  @@index([tenantId])
  @@map("departments")
}

model Employee {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  departmentId String    @map("department_id")
  name         String
  phone        String
  email        String?
  status        String    @default("active")
  workStartTime String?   @map("work_start_time")
  workEndTime   String?   @map("work_end_time")
  pauseStartAt  DateTime? @map("pause_start_at")
  pauseEndAt    DateTime? @map("pause_end_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department            @relation(fields: [departmentId], references: [id])
  consents     EmployeeConsent[]
  tokens       SurveyResponseToken[]

  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("employees")
}

model EmployeeConsent {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  employeeId           String    @map("employee_id")
  consentTermVersionId String    @map("consent_term_version_id")
  event                String
  source               String
  cpfHash              String?   @map("cpf_hash")
  token                String?   @unique
  tokenExpiresAt       DateTime? @map("token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee           @relation(fields: [employeeId], references: [id])
  consentTermVersion ConsentTermVersion @relation(fields: [consentTermVersionId], references: [id])

  @@index([tenantId, employeeId, createdAt(sort: Desc)])
  @@map("employee_consents")
}

model SurveyConfiguration {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  departmentId  String   @map("department_id")
  frequency     String
  workStartTime String   @map("work_start_time")
  workEndTime   String   @map("work_end_time")
  workDays      String   @default("1,2,3,4,5") @map("work_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id])
  questions    SurveyQuestion[]
  dispatches   SurveyDispatch[]

  @@unique([tenantId, departmentId])
  @@index([tenantId])
  @@map("survey_configurations")
}

model SurveyQuestion {
  id                    String @id @default(uuid())
  tenantId              String @map("tenant_id")
  surveyConfigurationId String @map("survey_configuration_id")
  text                  String
  order                 Int

  organization        Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  surveyConfiguration SurveyConfiguration @relation(fields: [surveyConfigurationId], references: [id], onDelete: Cascade)
  responseItems       SurveyResponseItem[]

  @@index([tenantId])
  @@map("survey_questions")
}

model SurveyDispatch {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  surveyConfigurationId String    @map("survey_configuration_id")
  scheduledAt           DateTime  @map("scheduled_at")
  dispatchedAt          DateTime? @map("dispatched_at")
  adherenceCheckedAt    DateTime? @map("adherence_checked_at")
  status                String    @default("scheduled")
  totalRecipients       Int       @default(0) @map("total_recipients")
  totalResponses        Int       @default(0) @map("total_responses")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization        Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  surveyConfiguration SurveyConfiguration @relation(fields: [surveyConfigurationId], references: [id])
  tokens              SurveyResponseToken[]
  responses           SurveyResponse[]

  @@index([tenantId])
  @@index([tenantId, status, scheduledAt])
  @@map("survey_dispatches")
}

model SurveyResponseToken {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  dispatchId    String    @map("dispatch_id")
  employeeId    String    @map("employee_id")
  token         String    @unique
  expiresAt     DateTime  @map("expires_at")
  workStartTime String    @map("work_start_time")
  workEndTime   String    @map("work_end_time")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  dispatch SurveyDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id])
  response SurveyResponse?

  @@index([tenantId])
  @@map("survey_response_tokens")
}

model SurveyResponse {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  dispatchId String   @map("dispatch_id")
  tokenId    String   @unique @map("token_id")
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch     SurveyDispatch      @relation(fields: [dispatchId], references: [id])
  token        SurveyResponseToken @relation(fields: [tokenId], references: [id])
  items        SurveyResponseItem[]

  @@index([tenantId])
  @@map("survey_responses")
}

model SurveyResponseItem {
  id               String @id @default(uuid())
  surveyResponseId String @map("survey_response_id")
  questionId       String @map("question_id")
  score            Int

  surveyResponse SurveyResponse @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  question       SurveyQuestion @relation(fields: [questionId], references: [id])

  @@map("survey_response_items")
}

model AnonymousReport {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  orgSlug    String    @map("org_slug")
  content    String
  category   String?
  status     String    @default("open")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("anonymous_reports")
}

model ActionPlan {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  title       String
  description String?
  status      String    @default("open")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks        ActionPlanTask[]

  @@index([tenantId])
  @@map("action_plans")
}

model ActionPlanTask {
  id           String    @id @default(uuid())
  actionPlanId String    @map("action_plan_id")
  title        String
  assigneeId   String?   @map("assignee_id")
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  actionPlan ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@index([actionPlanId])
  @@map("action_plan_tasks")
}

model Document {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  title     String
  type      String
  fileUrl   String?  @map("file_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([tenantId])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  version    Int
  fileUrl    String   @map("file_url")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_versions")
}

model Alert {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  departmentId String?   @map("department_id")
  type         String
  severity     String
  message      String
  isRead       Boolean   @default(false) @map("is_read")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("audit_logs")
}

model MessageLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  employeeId String?  @map("employee_id")
  type       String
  provider   String
  externalId String?  @map("external_id")
  status     String
  sentAt     DateTime @default(now()) @map("sent_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("message_logs")
}

model PgrReview {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  period       String
  fileUrl      String?   @map("file_url")
  status       String    @default("pending")
  reviewedAt   DateTime? @map("reviewed_at")
  nextReviewAt DateTime? @map("next_review_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("pgr_reviews")
}

model PlatformTermsVersion {
  id          String    @id @default(uuid())
  version     String    @unique
  title       String
  content     String
  isActive    Boolean   @default(false) @map("is_active")
  effectiveAt DateTime  @map("effective_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  acceptances PlatformTermsAcceptance[]

  @@map("platform_terms_versions")
}

model PlatformTermsAcceptance {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  termsVersionId String   @map("terms_version_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  ipAddress      String   @map("ip_address")
  userAgent      String   @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  user         OrganizationUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion PlatformTermsVersion @relation(fields: [termsVersionId], references: [id])

  @@unique([userId, termsVersionId])
  @@index([userId])
  @@map("platform_terms_acceptances")
}
