generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model Plan {
  id                String    @id @default(uuid())
  name              String
  description       String?
  maxEmployees      Int?      @map("max_employees")
  externalProductId String?   @map("external_product_id")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  prices        PlanPrice[]
  features      PlanFeature[]
  organizations Organization[]
  subscriptions OrganizationSubscription[]

  @@map("plans")
}

model PlanFeature {
  planId  String @map("plan_id")
  feature String

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, feature])
  @@map("plan_features")
}

model PlanPrice {
  id              String   @id @default(uuid())
  planId          String   @map("plan_id")
  externalPriceId String?  @unique @map("external_price_id")
  priceInCents    Int      @map("price_in_cents")
  currency        String   @default("brl")
  interval        String
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id])

  @@map("plan_prices")
}

model ConsentTermVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  content     String
  contentHash String   @map("content_hash")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  consents EmployeeConsent[]

  @@map("consent_term_versions")
}

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  planId               String?  @map("plan_id")
  externalCustomerId   String?  @unique @map("external_customer_id")
  billingStatus        String   @default("pending") @map("billing_status")
  maxEmployeesOverride Int?     @map("max_employees_override")
  timezone             String   @default("America/Sao_Paulo")
  isActive                Boolean   @default(true) @map("is_active")
  deletionScheduledAt     DateTime? @map("deletion_scheduled_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  plan Plan? @relation(fields: [planId], references: [id])

  users                 OrganizationUser[]
  departments           Department[]
  employees             Employee[]
  invitations           OrganizationInvitation[]
  subscription          OrganizationSubscription?
  webhookEvents         BillingWebhookEvent[]
  healthSurveyDispatches      HealthSurveyDispatch[]
  healthSurveyQuestions       HealthSurveyQuestion[]
  healthSurveyResponses       HealthSurveyResponse[]
  healthSurveyConfigs         HealthSurveyConfiguration[]
  documents             Document[]
  actionPlans           ActionPlan[]
  actionPlanTasks       ActionPlanTask[]
  actionPlanSuggestions ActionPlanSuggestion[]
  reports               AnonymousReport[]
  alerts                Alert[]
  auditLogs             AuditLog[]
  messageLogs           MessageLog[]
  pgrReviews            PgrReview[]
  consents              EmployeeConsent[]

  @@map("organizations")
}

model OrganizationUser {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String
  passwordHash    String    @map("password_hash")
  name            String
  role            String
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization                   Organization              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authTokens                     AuthToken[]
  termsAcceptances               PlatformTermsAcceptance[]
  dismissedActionPlanSuggestions ActionPlanSuggestion[]    @relation("ActionPlanSuggestionDismisser")
  uploadedDocumentVersions       DocumentVersion[]         @relation("DocumentVersionUploader")
  assignedActionPlanTasks        ActionPlanTask[]          @relation("ActionPlanTaskAssignee")
  resolvedAlerts                 Alert[]                   @relation("AlertResolver")
  auditLogs                      AuditLog[]                @relation("AuditLogActor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("organization_users")
}

model OrganizationInvitation {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  email     String
  role      String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("organization_invitations")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user OrganizationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model OrganizationSubscription {
  id                      String   @id @default(uuid())
  tenantId                String   @unique @map("tenant_id")
  planId                  String   @map("plan_id")
  externalSubscriptionId  String   @unique @map("external_subscription_id")
  status                  String
  currentPeriodStart      DateTime @map("current_period_start")
  currentPeriodEnd        DateTime @map("current_period_end")
  cancelAtPeriodEnd       Boolean  @default(false) @map("cancel_at_period_end")
  snapshotPlanName        String   @map("snapshot_plan_name")
  snapshotMaxEmployees    Int?     @map("snapshot_max_employees")
  snapshotPriceInCents    Int      @map("snapshot_price_in_cents")
  snapshotInterval        String   @map("snapshot_interval")
  snapshotExternalPriceId String   @map("snapshot_external_price_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id])
  features     SubscriptionFeature[]

  @@map("organization_subscriptions")
}

model SubscriptionFeature {
  subscriptionId String @map("subscription_id")
  feature        String

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, feature])
  @@map("subscription_features")
}

model BillingWebhookEvent {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  externalEventId String    @unique @map("external_event_id")
  type            String
  payload         Json?
  processedAt     DateTime? @map("processed_at")
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("billing_webhook_events")
}

model Department {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  workStartTime String   @default("09:00") @db.VarChar(5) @map("work_start_time")
  workEndTime   String   @default("18:00") @db.VarChar(5) @map("work_end_time")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees            Employee[]
  healthSurveyConfigDepartments HealthSurveyConfigDepartment[]
  healthSurveyDeptDispatches    HealthSurveyDeptDispatch[]
  healthSurveyResponses         HealthSurveyResponse[] @relation("HealthSurveyResponseDepartment")
  alerts               Alert[]
  workDays             DepartmentWorkDay[]
  pgrDeptResults       PgrDeptResult[]
  pgrQuestionResults   PgrQuestionResult[]

  @@index([tenantId])
  @@map("departments")
}

model Employee {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  departmentId  String    @map("department_id")
  name          String
  phone         String
  email         String?
  document      String?   @db.VarChar(50)
  status        String    @default("active")
  workStartTime String?   @db.VarChar(5) @map("work_start_time")
  workEndTime   String?   @db.VarChar(5) @map("work_end_time")
  pauseStartAt  DateTime? @map("pause_start_at")
  pauseEndAt    DateTime? @map("pause_end_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department            @relation(fields: [departmentId], references: [id])
  consents     EmployeeConsent[]
  healthSurveyResponseTokens HealthSurveyResponseToken[]
  workDays     EmployeeWorkDay[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("employees")
}

model DepartmentWorkDay {
  departmentId String     @map("department_id")
  dayOfWeek    Int        @map("day_of_week")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([departmentId, dayOfWeek])
  @@map("department_work_days")
}

model EmployeeWorkDay {
  employeeId String   @map("employee_id")
  dayOfWeek  Int      @map("day_of_week")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, dayOfWeek])
  @@map("employee_work_days")
}

model HealthSurveyConfigWorkDay {
  configId  String              @map("config_id")
  dayOfWeek Int                 @map("day_of_week")
  config    HealthSurveyConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@id([configId, dayOfWeek])
  @@map("health_survey_config_work_days")
}

model EmployeeConsent {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  employeeId           String    @map("employee_id")
  consentTermVersionId String    @map("consent_term_version_id")
  event                String
  source               String
  documentHash         String?   @map("document_hash")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization       Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee           @relation(fields: [employeeId], references: [id])
  consentTermVersion ConsentTermVersion @relation(fields: [consentTermVersionId], references: [id])

  @@index([tenantId, employeeId, createdAt(sort: Desc)])
  @@map("employee_consents")
}

model HealthSurveyConfiguration {
  id                   String                @id @default(uuid())
  tenantId             String                @map("tenant_id")
  name                 String                @default("Pesquisa de Saúde")
  description          String?
  frequency            String
  scheduledDayOfMonth  Int?                  @map("scheduled_day_of_month")
  dispatchTime         String                @default("09:00") @db.VarChar(5) @map("dispatch_time")
  workDays             HealthSurveyConfigWorkDay[]
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configDepartments    HealthSurveyConfigDepartment[]
  questions            HealthSurveyQuestion[]
  dispatches           HealthSurveyDispatch[]

  @@index([tenantId])
  @@map("health_survey_configurations")
}

model HealthSurveyQuestion {
  id                    String  @id @default(uuid())
  tenantId              String  @map("tenant_id")
  healthSurveyConfigurationId String  @map("health_survey_configuration_id")
  text                  String
  order                 Int
  scoreDirection        String  @default("higher_is_better") @map("score_direction")
  isActive              Boolean @default(true) @map("is_active")

  organization        Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  healthSurveyConfiguration HealthSurveyConfiguration  @relation(fields: [healthSurveyConfigurationId], references: [id], onDelete: Cascade)
  responseItems       HealthSurveyResponseItem[]

  @@index([tenantId])
  @@index([tenantId, healthSurveyConfigurationId])
  @@map("health_survey_questions")
}

model HealthSurveyDispatch {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  healthSurveyConfigurationId String    @map("health_survey_configuration_id")
  scheduledAt           DateTime  @map("scheduled_at")
  dispatchedAt          DateTime? @map("dispatched_at")
  adherenceCheckedAt    DateTime? @map("adherence_checked_at")
  status                String    @default("scheduled")
  source                String    @default("auto") @map("source")
  signedLinkToken       String?   @unique @db.VarChar(255) @map("signed_link_token")
  createdAt             DateTime  @default(now()) @map("created_at")

  organization        Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  healthSurveyConfiguration HealthSurveyConfiguration   @relation(fields: [healthSurveyConfigurationId], references: [id])
  tokens              HealthSurveyResponseToken[]
  responses           HealthSurveyResponse[]
  deptDispatches      HealthSurveyDeptDispatch[]

  @@index([tenantId])
  @@index([tenantId, status, scheduledAt])
  @@map("health_survey_dispatches")
}

model HealthSurveyResponseToken {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  dispatchId    String    @map("dispatch_id")
  employeeId    String    @map("employee_id")
  token         String    @unique
  shortCode     String?   @map("short_code") @db.VarChar(7)
  expiresAt     DateTime  @map("expires_at")
  workStartTime String    @db.VarChar(5) @map("work_start_time")
  workEndTime   String    @db.VarChar(5) @map("work_end_time")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  dispatch HealthSurveyDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, shortCode])
  @@index([tenantId])
  @@index([dispatchId, employeeId])
  @@map("health_survey_response_tokens")
}

model HealthSurveyResponse {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  dispatchId   String   @map("dispatch_id")
  departmentId String?  @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dispatch     HealthSurveyDispatch       @relation(fields: [dispatchId], references: [id])
  department   Department?               @relation("HealthSurveyResponseDepartment", fields: [departmentId], references: [id])
  items        HealthSurveyResponseItem[]

  @@index([tenantId])
  @@index([dispatchId])
  @@map("health_survey_responses")
}

model HealthSurveyResponseItem {
  id               String @id @default(uuid())
  healthSurveyResponseId String @map("health_survey_response_id")
  questionId       String @map("question_id")
  score            Int

  healthSurveyResponse HealthSurveyResponse @relation(fields: [healthSurveyResponseId], references: [id], onDelete: Cascade)
  question       HealthSurveyQuestion @relation(fields: [questionId], references: [id])

  @@index([healthSurveyResponseId])
  @@map("health_survey_response_items")
}

model HealthSurveyConfigDepartment {
  configId     String @map("config_id")
  departmentId String @map("department_id")

  config     HealthSurveyConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)
  department Department                @relation(fields: [departmentId], references: [id])

  @@id([configId, departmentId])
  @@index([departmentId])
  @@map("health_survey_config_departments")
}

model HealthSurveyDeptDispatch {
  id              String   @id @default(uuid())
  dispatchId      String   @map("dispatch_id")
  departmentId    String   @map("department_id")
  totalRecipients Int      @default(0) @map("total_recipients")
  totalResponses  Int      @default(0) @map("total_responses")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dispatch   HealthSurveyDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  department Department           @relation(fields: [departmentId], references: [id])

  @@unique([dispatchId, departmentId])
  @@index([departmentId])
  @@map("health_survey_dept_dispatches")
}

model AnonymousReport {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  orgSlug    String    @map("org_slug")
  content    String
  category   String?
  status     String    @default("open")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlans  ActionPlan[] @relation("ActionPlanOriginReport")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("anonymous_reports")
}

model ActionPlan {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  alertId     String?   @map("alert_id")
  reportId    String?   @map("report_id")
  title       String
  description String?
  status      String    @default("open")
  priority    String    @default("medium")
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alert        Alert?                     @relation("ActionPlanOriginAlert", fields: [alertId], references: [id])
  report       AnonymousReport?           @relation("ActionPlanOriginReport", fields: [reportId], references: [id])
  tasks        ActionPlanTask[]
  suggestion   ActionPlanSuggestion?      @relation("ActionPlanSuggestionConvertedPlan")

  @@index([tenantId])
  @@map("action_plans")
}

model ActionPlanTask {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  actionPlanId String    @map("action_plan_id")
  title        String
  assigneeId   String?   @map("assignee_id")
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actionPlan   ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  assignee     OrganizationUser? @relation("ActionPlanTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actionPlanId])
  @@map("action_plan_tasks")
}

model ActionPlanSuggestion {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  suggestionKey String    @map("suggestion_key")
  title         String
  description   String
  priority      String    @default("medium")
  reason        String
  status        String    @default("pending")
  dismissedAt   DateTime? @map("dismissed_at")
  dismissedBy   String?   @map("dismissed_by")
  actionPlanId  String?   @unique @map("action_plan_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dismisser    OrganizationUser?          @relation("ActionPlanSuggestionDismisser", fields: [dismissedBy], references: [id])
  actionPlan   ActionPlan?                @relation("ActionPlanSuggestionConvertedPlan", fields: [actionPlanId], references: [id])
  tasks        ActionPlanSuggestionTask[]

  @@index([tenantId, status])
  @@index([tenantId, suggestionKey])
  @@map("action_plan_suggestions")
}

model ActionPlanSuggestionTask {
  id           String @id @default(uuid())
  suggestionId String @map("suggestion_id")
  title        String
  sortOrder    Int    @default(0) @map("sort_order")

  suggestion ActionPlanSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId])
  @@map("action_plan_suggestion_tasks")
}

model Document {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  title     String
  type      String
  fileUrl   String?  @map("file_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@index([tenantId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  version      Int
  fileUrl      String   @map("file_url")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy OrganizationUser?  @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@map("document_versions")
}

model Alert {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  departmentId String?   @map("department_id")
  type         String
  severity     String
  message      String
  isRead       Boolean   @default(false) @map("is_read")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedBy   String?   @map("resolved_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id])
  actionPlans  ActionPlan[] @relation("ActionPlanOriginAlert")
  resolver     OrganizationUser? @relation("AlertResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, resolvedAt])
  @@index([tenantId, isRead, severity])
  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        OrganizationUser? @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model MessageLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  employeeId String?  @map("employee_id")
  type       String
  provider   String
  externalId String?  @map("external_id")
  status     String
  sentAt     DateTime @default(now()) @map("sent_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("message_logs")
}

model PgrReview {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  period       String
  fileUrl      String?   @map("file_url")
  status       String    @default("pending")
  reviewedAt   DateTime? @map("reviewed_at")
  nextReviewAt DateTime? @map("next_review_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deptResults     PgrDeptResult[]
  questionResults PgrQuestionResult[]

  @@index([tenantId])
  @@map("pgr_reviews")
}

model PgrDeptResult {
  id              String   @id @default(uuid())
  pgrReviewId     String   @map("pgr_review_id")
  departmentId    String   @map("department_id")
  departmentName  String   @map("department_name")
  employeeCount   Int      @map("employee_count")
  avgScore        Float    @map("avg_score")
  responseCount   Int      @map("response_count")
  totalRecipients Int      @map("total_recipients")
  createdAt       DateTime @default(now()) @map("created_at")

  pgrReview  PgrReview  @relation(fields: [pgrReviewId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([pgrReviewId])
  @@map("pgr_dept_results")
}

model PgrQuestionResult {
  id             String   @id @default(uuid())
  pgrReviewId    String   @map("pgr_review_id")
  departmentId   String   @map("department_id")
  questionId     String   @map("question_id")
  questionText   String   @map("question_text")
  questionOrder  Int      @map("question_order")
  scoreDirection String   @default("higher_is_better") @map("score_direction")
  avgScore       Float    @map("avg_score")
  responseCount  Int      @map("response_count")
  createdAt      DateTime @default(now()) @map("created_at")

  pgrReview  PgrReview  @relation(fields: [pgrReviewId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([pgrReviewId])
  @@map("pgr_question_results")
}

model PlatformTermsVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  content     String
  isActive    Boolean  @default(false) @map("is_active")
  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")

  acceptances PlatformTermsAcceptance[]

  @@map("platform_terms_versions")
}

model PlatformTermsAcceptance {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  termsVersionId String   @map("terms_version_id")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  user         OrganizationUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion PlatformTermsVersion @relation(fields: [termsVersionId], references: [id])

  @@unique([userId, termsVersionId])
  @@index([userId])
  @@map("platform_terms_acceptances")
}

model PrivacyPolicyVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  title       String
  content     String
  isActive    Boolean  @default(false) @map("is_active")
  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("privacy_policy_versions")
}

model RequestLog {
  id              String   @id @default(uuid())
  method          String
  path            String
  query           String?
  ip              String?
  userAgent       String?  @map("user_agent")
  requestHeaders  Json     @map("request_headers")
  requestBody     Json?    @map("request_body")
  responseStatus  Int?     @map("response_status")
  responseHeaders Json?    @map("response_headers")
  responseBody    Json?    @map("response_body")
  durationMs      Int?     @map("duration_ms")
  tenantId        String?  @map("tenant_id")
  userId          String?  @map("user_id")
  userType        String?  @map("user_type")
  isRedirect      Boolean  @default(false) @map("is_redirect")
  redirectTo      String?  @map("redirect_to")
  errorMessage    String?  @map("error_message")
  errorStack      String?  @map("error_stack")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([method])
  @@index([responseStatus])
  @@index([tenantId])
  @@index([userId])
  @@map("request_logs")
}

model JobLog {
  id            String    @id @default(uuid())
  jobId         String    @map("job_id")
  jobName       String    @map("job_name")
  queueName     String    @map("queue_name")
  status        String
  attemptNumber Int       @default(1) @map("attempt_number")
  maxAttempts   Int       @default(1) @map("max_attempts")
  payload       Json?
  result        Json?
  errorMessage  String?   @map("error_message")
  errorStack    String?   @map("error_stack")
  queuedAt      DateTime? @map("queued_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  durationMs    Int?      @map("duration_ms")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([jobName])
  @@index([status])
  @@index([queueName])
  @@map("job_logs")
}
